# ~/.zshrc — managed by chezmoi
# (replaces the home-manager-generated zsh config)

# ---- history ----
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt hist_ignore_all_dups
setopt share_history

# ---- oh-my-zsh ----
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="wedisagree"
plugins=(git sudo)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ---- autosuggestions + syntax highlighting (pacman packages) ----
[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
# syntax-highlighting must be sourced last
[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ---- environment ----
export EDITOR=vim

# ---- aliases ----
# Modern replacements for the coreutils originals. Aliases are only expanded by
# interactive shells, so scripts and anything run through `sh -c` still get the
# real binaries — these can't break a Makefile or a package hook.
alias ls='lsd'
alias ll='ls -l'
alias la='ls -lA'
# lsd's tree view; --depth keeps a stray `lt ~` from walking the whole home dir.
alias lt='ls --tree --depth 2'
# --paging=never because this replaces `cat`: bat's default (`auto`) sends
# anything longer than the window through less, which then WIPES it off the
# screen on quit — the exact opposite of what you ran cat for. Piped output is
# unaffected either way; bat drops to plain text when stdout isn't a terminal.
alias cat='bat --paging=never'
# The real cat, for when the decoration is in the way (`\cat` works too).
alias ccat='command cat'
alias top='btop'
alias t='tmux'
alias ta='tmux attach'
alias td='tmux detach'
# Re-apply dotfiles managed by chezmoi
alias update='chezmoi apply'
# Edit a dotfile through chezmoi (edits the source, then apply)
alias dots='chezmoi'
# Full system + AUR upgrade, repos first. The AUR half is `-Sua`, not `-Syu`:
# -Syu there would re-sync and redo the repo half pacman just did. See
# MAINTENANCE.md §1.
alias upgrade='sudo pacman -Syu && yay -Sua'
# Preview both halves without changing anything. checkupdates uses a throwaway
# sync db, so unlike `pacman -Sy` it cannot leave the system half-upgraded. It
# exits 2 when there is nothing to do, so the halves are chained with `;`.
alias upcheck='checkupdates; yay -Qua'

# ---- cleanup ----
# List orphans before deleting any: a package declared in this repo but recorded
# by pacman as a dependency is indistinguishable from a real orphan here (vlc
# was one cleanup away from being removed). `./bin/pkg-diff.sh` names those.
alias orphans='pacman -Qdtq'
# Removing orphans creates new ones, so re-run until `orphans` is empty.
alias orphanclean='sudo pacman -Rns $(pacman -Qdtq)'
# Trim the package caches, keeping the 3 newest versions of each package: on a
# host without btrfs snapshots the pacman cache is the only rollback path, so
# never `paccache -rk0` or `pacman -Sc`. -ruk0 drops uninstalled packages.
alias cleanup='sudo paccache -rk3 && sudo paccache -ruk0 && yay -Sc'
# Merge .pacnew files an upgrade left behind — config drift that otherwise
# surfaces weeks later.
alias pacmerge='sudo DIFFPROG="nvim -d" pacdiff'

# ---- dotfiles repo ----
# Located via chezmoi rather than hardcoded: the checkout is under ~/Desktop on
# one host and ~/dotfiles per the README on others. Needs sourceDir in
# ~/.config/chezmoi/chezmoi.toml, which .chezmoi.toml.tmpl now writes.
export DOTFILES="${DOTFILES:-$(chezmoi source-path 2>/dev/null | xargs -r dirname)}"
alias dotcd='cd "$DOTFILES"'

# Pull hand-edits from ~/.config back into the repo (wraps `chezmoi re-add`).
# PREVIEWS by default; needs --apply to touch the repo.
alias dotsync='"$DOTFILES"/bin/dotsync.sh'

# ---- keychain (ssh-agent) ----
# keychain 3.x uses verbs (`add`) and dropped `--agents` (the agent type is
# inferred from the key), so the old flag-only form warns on every new shell.
if command -v keychain >/dev/null 2>&1; then
  eval "$(keychain add --eval --quiet id_ed25519)"
fi
