# chezmoi machine-local config — generated by `chezmoi init` on each host.
# You are prompted ONCE per machine; the answer is stored in
# ~/.config/chezmoi/chezmoi.toml and reused by every `chezmoi apply`.
{{- $gpu := promptStringOnce . "gpu" "GPU vendor for this host (intel / amd / nvidia)" "intel" }}

[data]
    gpu = {{ $gpu | quote }}
